rules_version = '2';

// Firestore — cole em Firebase Console › Firestore Database › Regras (ou: firebase deploy --only firestore:rules)
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- funções auxiliares ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Texto com tamanho limitado (evita documentos gigantes)
    function isValidString(text, minLen, maxLen) {
      return text is string && text.size() >= minLen && text.size() <= maxLen;
    }

    // ---------- PERFIL ----------
    match /users/{uid} {
      // Outros usuários logados leem (perfil público, ranking, amigos)
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      // Dados PRIVADOS (XP, rotina, hábitos, estante, finanças, diário): só o dono
      match /data/{docId} {
        allow read, write: if isOwner(uid);
      }

      // Resumo público: o dono publica, usuários logados leem
      match /public/{docId} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    // ---------- @USUÁRIO ----------
    // Guarda { uid, email }. O e-mail precisa ficar aqui porque o login por @ consulta este
    // documento ANTES de a pessoa estar logada (por isso o "get" é público).
    match /usernames/{handle} {
      allow get: if true;
      // listar só os @ da própria conta (usado ao trocar de @)
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn()
                    && handle.matches('^[a-z0-9_.]{3,20}$')
                    && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ---------- PUBLICAÇÕES (feed geral) ----------
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && (!('text' in request.resource.data) || isValidString(request.resource.data.text, 0, 2000));
      allow update: if signedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // ---------- GRUPOS ----------
    match /groups/{groupId} {

      function changedKeys() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      function isGroupMember() {
        return request.auth.uid in resource.data.memberIds;
      }

      function isGroupAdmin() {
        return resource.data.ownerId == request.auth.uid
          || ('admins' in resource.data && request.auth.uid in resource.data.admins);
      }

      // Lista de membros: só pode DIMINUIR, e só de dois jeitos:
      //  - a própria pessoa sai do grupo, ou
      //  - um ADM remove alguém (o criador nunca é removido por outra pessoa)
      function memberIdsChangeOk() {
        return !changedKeys().hasAny(['memberIds'])
          || (
            resource.data.memberIds.hasAll(request.resource.data.memberIds)
            && request.resource.data.memberIds.size() < resource.data.memberIds.size()
            && (
              (
                !(request.auth.uid in request.resource.data.memberIds)
                && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
              )
              || (
                isGroupAdmin()
                && resource.data.ownerId in request.resource.data.memberIds
              )
            )
          );
      }

      // Entrar pelo código: a pessoa só pode adicionar a si mesma (e limpar o convite dela)
      function isJoining() {
        return !isGroupMember()
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.memberIds.hasAll(resource.data.memberIds)
          && changedKeys().hasOnly(['memberIds', 'members', 'invites']);
      }

      // Abrir um grupo exige o id (que vem do código de convite)
      allow get: if signedIn();
      // Listar só os grupos em que você está
      allow list: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds is list
                    && request.resource.data.memberIds.size() == 1
                    && request.auth.uid in request.resource.data.memberIds;

      allow update: if signedIn() && (
        (
          isGroupMember()
          // criador, código e data de criação nunca mudam
          && !changedKeys().hasAny(['ownerId', 'code', 'createdAt'])
          // só o criador escolhe os ADMs
          && (!changedKeys().hasAny(['admins']) || resource.data.ownerId == request.auth.uid)
          && memberIdsChangeOk()
        )
        || isJoining()
      );

      // Só o criador apaga o grupo
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // ---------- CÓDIGO DE CONVITE -> GRUPO ----------
    match /groupCodes/{code} {
      allow get: if signedIn();
      allow list: if false; // impede varrer todos os códigos
      // só o criador de um grupo existente cria o código dele
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow update: if false; // códigos não mudam
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Todo o resto fica bloqueado.
  }
}
